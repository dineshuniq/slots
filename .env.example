# ---------------------------------------------------------------------------
# Postgres connection string.
# Works unchanged with Supabase, Neon, or any other Postgres.
#
#   Supabase  : use the CONNECTION POOLER string from Project Settings.
#               Port 6543 is transaction mode (recommended for serverless).
#               Port 5432 is session mode - use this for schema migrations,
#               and as a fallback if 6543 is unreliable.
#   Neon      : postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Local     : postgresql://postgres:postgres@localhost:5432/panel_slots
# ---------------------------------------------------------------------------
DATABASE_URL=

# Secret used to sign the session cookie (any long random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# IANA timezone the panels operate in, e.g. Asia/Kolkata, Europe/London.
# Both the server and the browser resolve "today" through this, so the
# carousel and the past-slot rules agree. Leave blank to use each machine's
# own local time (fine for local dev, not for a Vercel deploy).
NEXT_PUBLIC_SCHEDULE_TIMEZONE=Asia/Kolkata

# Controller accounts live in the `controllers` table, not in env vars.
# `npm run db:seed` creates them; each controller changes their own password
# from the app afterwards.
